# ===== 1. Telegram API (https://my.telegram.org -> API development tools) =====
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef
PHONE=+998901234567
SESSION_NAME=jobfilter

# ===== 2. Qaysi kanallarni kuzatish =====
# HECH NARSA YOZMASANGIZ (avto rejim): obuna bo'lgan kanal/guruhlaringiz ichidan
# nomida "vakansiya, job, ish, hr, developer..." bor kanallar avtomatik tanlanadi.
# O'zingiz yaratgan/admin bo'lgan kanallar hisobga olinmaydi.
# Qaysilari tanlanishini ko'rish: python main.py --list
#
# CHANNELS=all              -> barcha obuna kanal/guruhlar (filtr keraksizini baribir tashlaydi)
# CHANNELS=auto,@kanal1     -> avto + nomi mos kelmagan qo'shimcha kanallar
# CHANNELS=@kanal1,@kanal2  -> faqat shu kanallar
CHANNELS=
# Yoki Telegram papkasi nomi (masalan: IT Vakansiyalar)
FOLDER=
# Kuzatilmasin (vergul bilan; @username yoki -100... ID)
EXCLUDE_CHANNELS=

# ===== 3. Skanerlash jadvali =====
# Yangi kanal uchun necha kun orqaga qaralsin
BACKFILL_DAYS=15
# Har necha daqiqada yangi postlar tekshirilsin
SCAN_INTERVAL_MIN=60
# Yangi kanalga qo'shilganingizni tekshirish (Telegram hodisasiga qo'shimcha, zaxira)
CHANNEL_CHECK_MIN=5
# true = post chiqishi bilan darhol (soatni kutmasdan) ham tekshirish
REALTIME=false
# Bir tekshiruvda shundan ko'p yangi vakansiya bo'lsa — bitta umumiy xabar keladi
NOTIFY_MAX=5

# ===== 4. Filtr sozlamalari =====
# Qo'shimcha kalit so'zlar (vergul bilan), masalan: Unity,1C
INCLUDE_EXTRA=
# Bu so'zlar bo'lgan postlar tashlab yuboriladi, masalan: Samarqand,стажировка
EXCLUDE_EXTRA=
# Faqat shu darajalar bo'lsa o'tkazib yuborish (Intern,Junior,Middle,Senior,Lead)
EXCLUDE_LEVELS=
# true = postda "vakansiya/maosh/talablar..." kabi belgi bo'lishi shart
REQUIRE_VACANCY_MARKER=true

# ===== 5. Natijalar qayerga boradi — sizning botingiz =====
# @BotFather dagi bot tokeni. Bot menyusi: Flutter / iOS / Android / Backend /
# Fullstack / Bugungi / Remote / Statistika + so'z bilan qidiruv.
# Muhim: bu token boshqa kod (n8n, webhook va h.k.) tomonidan ishlatilmasligi kerak.
# Bo'sh qoldirsangiz -> natijalar Saved Messages ga tushadi.
BOT_TOKEN=
# Botdan yana kim foydalana oladi (Telegram user ID, vergul bilan). Siz avtomatik egasiz.
ALLOWED_USERS=
BOT_SESSION_NAME=jobfilter_bot

# ===== 6. (Ixtiyoriy) AI bilan aqlli saralash — Claude API =====
# Kalit bo'lmasa faqat kalit so'z filtri ishlaydi.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
AI_MIN_SCORE=6
PROFILE=Fullstack dasturchi, Toshkent. Asosiy: Flutter (Dart, Bloc/Cubit, Riverpod, Provider), native iOS va Android ham qiziq. Backend: PHP (Laravel), Node.js, Python, Go. Fullstack vakansiyalar ham mos. Ofis, gibrid yoki remote.

# ===== Fayllar =====
DB_PATH=jobs.db
CSV_PATH=vakansiyalar.csv
