# ===== 1. Telegram API (https://my.telegram.org -> API development tools) =====
# Bular faqat BOT uchun kerak (Telethon bot tokeni bilan ulanadi).
# Akkauntga kirish, telefon raqam va .session fayli TALAB QILINMAYDI.
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# ===== 2. Qaysi kanallar o'qiladi =====
# Kanallar t.me/s/<nom> ochiq sahifasi orqali o'qiladi — obuna bo'lish shart emas,
# lekin kanal OCHIQ bo'lishi kerak (egasi "preview" ni o'chirmagan bo'lsin).
# Tekshirish: brauzerda t.me/s/kanal_nomi ochilsa — ishlaydi.
# Yoki: python main.py --list
#
# Vergul bilan. Format ixtiyoriy: @kanal, t.me/kanal, https://t.me/kanal
CHANNELS=@dartuz_jobs,@progjob,@uzdev_jobs
# Ro'yxatdan chiqarish (yopiq kanallarni shu yerga qo'ysangiz, qayta tekshirilmaydi)
EXCLUDE_CHANNELS=

# ===== 3. Skanerlash jadvali =====
# Yangi kanal uchun necha kun orqaga qaralsin
BACKFILL_DAYS=15
# Har necha daqiqada yangi postlar tekshirilsin
SCAN_INTERVAL_MIN=60
# Har necha daqiqada .env dagi CHANNELS ro'yxati qayta o'qilsin
# (kanal qo'shsangiz, botni qayta ishga tushirish shart emas)
CHANNEL_CHECK_MIN=15
# Bir tekshiruvda shundan ko'p yangi vakansiya bo'lsa — bitta umumiy xabar keladi
NOTIFY_MAX=5

# ===== 4. Filtr sozlamalari =====
# Qo'shimcha kalit so'zlar (vergul bilan), masalan: Unity,1C
INCLUDE_EXTRA=
# Bu so'zlar bo'lgan postlar tashlab yuboriladi, masalan: Samarqand,стажировка
EXCLUDE_EXTRA=
# Faqat shu darajalar bo'lsa o'tkazib yuborish (Intern,Junior,Middle,Senior,Lead)
EXCLUDE_LEVELS=
# true = postda "vakansiya/maosh/talablar..." kabi belgi bo'lishi shart
REQUIRE_VACANCY_MARKER=true

# ===== 5. Natijalar qayerga boradi — sizning botingiz =====
# @BotFather dagi bot tokeni. Bot menyusi: Flutter / iOS / Android / Backend /
# Fullstack / Bugungi / Remote / Statistika + so'z bilan qidiruv.
# Muhim: bu token boshqa kod (n8n, webhook va h.k.) tomonidan ishlatilmasligi kerak.
BOT_TOKEN=
# SIZNING Telegram user ID ingiz — admin huquqlari uchun (🔄 qayta tekshirish,
# 📡 kanallar ro'yxati, texnik hisobotlar). @userinfobot ko'rsatadi.
# Bot qolganlar uchun OCHIQ: kim /start bossa foydalana oladi.
OWNER_ID=
BOT_SESSION_NAME=jobfilter_bot

# ===== 6. (Ixtiyoriy) AI bilan aqlli saralash =====
# OpenAI-mos chat/completions endpoint (Azure AI Foundry, OpenAI, OpenRouter...).
# AI_API_KEY bo'sh bo'lsa — faqat kalit so'z filtri ishlaydi.
AI_ENDPOINT=https://<resurs>.services.ai.azure.com/openai/v1
AI_API_KEY=
AI_MODEL=DeepSeek-V4-Flash-0731
AI_MIN_SCORE=6
PROFILE=Fullstack dasturchi, Toshkent. Asosiy: Flutter (Dart, Bloc/Cubit, Riverpod, Provider), native iOS va Android ham qiziq. Backend: PHP (Laravel), Node.js, Python, Go. Fullstack vakansiyalar ham mos. Ofis, gibrid yoki remote.

# ===== Fayllar =====
DB_PATH=jobs.db
CSV_PATH=vakansiyalar.csv
